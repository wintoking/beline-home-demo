/* Screen adaptation of the supplied BE-TECH VI, pp. 20–28 and 29–39. */
page{--brand:#ff5100;background:#f5f5f5;color:#2e2e2e;font-family:"Beline UI","Source Han Sans CN","PingFang SC","Microsoft YaHei",sans-serif}
button{border-radius:8rpx;background:#f1f1f1;color:#2e2e2e;font-weight:500}.primary{background:#ff5100;color:#000;font-weight:600}
.vi-brand-row{display:flex;align-items:center;justify-content:space-between;gap:24rpx;margin:0 0 32rpx;padding:12rpx 0 20rpx;border-bottom:1rpx solid #e5e5e5}
.vi-corporate-logo{width:295rpx;height:33rpx;flex-shrink:0}.vi-brand-row>text{font-size:23rpx;letter-spacing:1rpx;color:#737373;font-weight:500}
.eyebrow{color:#737373;font-size:20rpx;letter-spacing:2.5rpx}.h1{font-weight:650}.muted,.sub{color:#737373}
.card,.metric,.roomcard{border-color:#e8e8e8;border-radius:10rpx;box-shadow:none}.hero{background:#2e2e2e;border-radius:10rpx;border-top:6rpx solid #ff5100;position:relative;overflow:hidden}
.hero:after{content:'';position:absolute;right:30rpx;top:30rpx;width:34rpx;height:34rpx;border-top:4rpx solid #ff5100;border-right:4rpx solid #ff5100;pointer-events:none}
.hero .muted{color:#c7c7c7}.hero .primary{position:relative;z-index:1}.hero .pill{color:#fff;background:#454545}.roomno{font-weight:600}
.pill{color:#616161;background:#f0f0f0;border-radius:5rpx}.pill.green{color:#426300;background:#f0f6e5}.pill.blue{color:#1226aa;background:#eff1fc}.pill.orange{color:#765800;background:#fff8d8}
.quick .symbol{background:#fff0e8;border-radius:8rpx;display:flex;align-items:center;justify-content:center}.quick .symbol image{width:39rpx;height:39rpx}
.mark{border-radius:9rpx;background:#fff0e8;color:#b83a00}.mark image{height:44rpx;width:44rpx}.mark.brand-symbol{background:#2e2e2e}.mark.brand-symbol image{height:51rpx;width:43rpx}
.tabs{background:#eaeaea;border-radius:8rpx}.tabs button{border-radius:4rpx;color:#737373}.tabs .selected{background:#fff;color:#b83a00;box-shadow:none}
.amount{color:#b83a00}.hero .amount{color:#fff}.notice{border-radius:8rpx;border:1rpx solid #e5e5e5;background:#f1f1f1;color:#616161}.section{font-weight:600}
input,textarea,.select{border-color:#dedede;border-radius:8rpx}.field text{color:#616161}.field input:focus,.field textarea:focus{border-color:#ff5100}
.roomcard{border-top:4rpx solid #bdbdbd}.roomcard.occupied{border-top-color:#80bc00}.roomcard.reserved{border-top-color:#1226aa}.roomcard.repair,.roomcard.turnover{border-top-color:#f3c300}
.steps{color:#737373}.footer{color:#737373;letter-spacing:1rpx}.blue{color:#1226aa}
