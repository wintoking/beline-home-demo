page{background:#fafafa;color:#2e2e2e;font-family:"Beline UI","Source Han Sans CN","PingFang SC","Microsoft YaHei",sans-serif;font-size:28rpx}view,text,button,input,textarea,picker{box-sizing:border-box}button{font-size:27rpx;border:0;border-radius:18rpx;line-height:2.8;background:#f5f5f5;color:#444444}button:after{border:0}.page{padding:34rpx 30rpx 50rpx}.eyebrow{font-size:21rpx;letter-spacing:3rpx;color:#606060}.h1{font-size:44rpx;font-weight:700;margin:14rpx 0}.muted{font-size:24rpx;color:#606060;line-height:1.8}.row{display:flex;align-items:center;justify-content:space-between;gap:18rpx}.card{padding:30rpx;background:white;border:1rpx solid #f5f5f5;border-radius:26rpx;margin:24rpx 0;box-shadow:0 6rpx 20rpx #2e2e2e04}.hero{background:#2e2e2e;color:white;padding:38rpx;border-radius:30rpx;margin-top:30rpx}.hero .muted{color:#9b9b9b}.roomno{font-size:70rpx;font-weight:700;line-height:1.2;margin:14rpx 0}.pill{display:inline-block;border-radius:10rpx;padding:7rpx 13rpx;background:#f5f5f5;color:#444444;font-size:22rpx}.pill.orange{color:#606060;background:#f5f5f5}.section{font-size:31rpx;font-weight:650;margin:36rpx 0 16rpx}.grid{display:grid;grid-template-columns:1fr 1fr;gap:20rpx}.metric{padding:26rpx;background:white;border-radius:22rpx;border:1rpx solid #f5f5f5}.number{font-size:42rpx;font-weight:700;margin-top:10rpx}.quick{display:grid;grid-template-columns:repeat(4,1fr);margin:30rpx 0}.quick button{background:transparent;border-radius:0;padding:8rpx;font-size:24rpx;line-height:1.7}.quick .symbol{width:78rpx;height:78rpx;border-radius:24rpx;background:#f5f5f5;margin:0 auto 14rpx;font-size:35rpx;color:#444444;line-height:78rpx}.primary{background:#444444;color:white}.wide{width:100%;margin-top:28rpx}.sub{font-size:24rpx;color:#606060;line-height:1.7}.strong{font-size:30rpx;font-weight:650}.amount{font-size:40rpx;font-weight:700;margin:20rpx 0;color:#2e2e2e}.divider{height:1rpx;background:#f5f5f5;margin:22rpx 0}.notice{padding:18rpx 22rpx;background:#f5f5f5;color:#606060;font-size:22rpx;line-height:1.7;border-radius:16rpx;margin-top:26rpx}.field{margin:25rpx 0}.field text{display:block;color:#606060;font-size:25rpx;margin-bottom:12rpx}input,textarea,.select{width:100%;border:1rpx solid #ebebeb;border-radius:16rpx;background:white;padding:23rpx;font-size:28rpx;min-height:90rpx}textarea{height:220rpx}.empty{text-align:center;color:#606060;padding:70rpx 20rpx}.tabs{display:flex;gap:10rpx;padding:8rpx;background:#f5f5f5;border-radius:18rpx;margin:24rpx 0}.tabs button{flex:1;background:transparent;font-size:25rpx}.tabs .selected{background:white;color:#444444;box-shadow:0 3rpx 10rpx #2e2e2e10}.smallbtn{font-size:24rpx;line-height:2.4;padding:0 24rpx;margin:0}.roomgrid{display:grid;grid-template-columns:1fr 1fr;gap:18rpx}.roomcard{background:white;border:1rpx solid #ebebeb;border-radius:22rpx;padding:25rpx}.roomcard .roomno{font-size:42rpx}.mark{width:84rpx;height:84rpx;border-radius:26rpx;background:#ebebeb;display:flex;align-items:center;justify-content:center;font-size:36rpx}.steps{display:flex;gap:8rpx;justify-content:space-between;font-size:22rpx;color:#606060;margin-top:30rpx}.blue{color:#606060}.footer{text-align:center;color:#757575;font-size:21rpx;margin-top:36rpx;letter-spacing:2rpx}
