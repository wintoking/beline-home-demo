<view class="page"><view class="vi-brand-row"><image class="vi-corporate-logo" src="/assets/brand/betech-logo-orange.png" mode="aspectFit"/><text>Beline Home</text></view><view class="eyebrow">MY Beline Home</view><view class="h1">我的</view><view class="card row"><view class="mark">{{isStaff?'管':'住'}}</view><view style="flex:1"><view class="strong">{{isStaff?tenant.owner:room.resident||'演示住户'}}</view><view class="sub">{{tenant.name}} · {{isStaff?'管家工作区':'住户工作区'}}</view></view><text class="pill">DEMO</text></view><view class="section">切换体验身份</view><view class="tabs"><button class="{{!isStaff?'selected':''}}" data-value="resident" bindtap="role">住户</button><button class="{{isStaff?'selected':''}}" data-value="staff" bindtap="role">管家</button></view><view class="field"><text>演示商户</text><picker range="{{tenants}}" range-key="name" value="{{tenantIndex}}" bindchange="tenant"><view class="select row"><text>{{tenant.name}}</text><text>⌄</text></view></picker></view><view class="field"><text>当前房间</text><picker range="{{rooms}}" range-key="selectorText" value="{{roomIndex}}" bindchange="room"><view class="select row"><text>{{room.selectorText}}</text><text>⌄</text></view></picker></view><view class="card"><view class="row" bindtap="contract"><text>我的租约</text><text>›</text></view><view class="divider"></view><view class="row" bindtap="contact"><text>联系管家</text><text>›</text></view></view><button bindtap="reset">重置演示数据</button><view class="notice">原生微信小程序演示工程。无真实登录、合同签署、支付、蓝牙或 TTLock 请求。角色切换用于展示产品效果，不代表实际权限认证。</view><view class="footer">Beline Home · DEMO 1.0</view></view>
