<view class="page"><view class="vi-brand-row"><image class="vi-corporate-logo" src="/assets/brand/betech-logo-orange.png" mode="aspectFit"/><text>Beline Home</text></view><view class="eyebrow">MY BILLS</view><view class="h1">{{isStaff?'账单与收款':'费用账单'}}</view><view class="muted">{{isStaff?tenant.name:room.project+' · '+room.number}} · 本期账单清晰可查</view><view class="hero"><view class="muted">待缴费用</view><view class="roomno" style="font-size:56rpx">{{unpaidText}}</view><view class="muted">模拟支付后，住户与管家工作区同步更新</view></view><view class="tabs"><button class="{{filter==='all'?'selected':''}}" data-value="all" bindtap="filter">全部</button><button class="{{filter==='unpaid'?'selected':''}}" data-value="unpaid" bindtap="filter">待缴费</button><button class="{{filter==='paid'?'selected':''}}" data-value="paid" bindtap="filter">已缴费</button></view><view class="card" wx:for="{{visibleBills}}" wx:key="id"><view class="row"><text class="strong">{{item.kind}} · {{item.roomNumber}}</text><text class="pill {{item.status==='unpaid'?'orange':item.status==='paid'?'green':'gray'}}">{{item.statusText}}</text></view><view class="amount">{{item.amountText}}</view><view class="row"><text class="sub">{{item.period}} · {{item.resident}}</text><text class="sub">截至 {{item.due}}</text></view><view class="divider"></view><view class="row"><text class="sub">{{item.items[0].label}}</text><button class="smallbtn {{item.status==='unpaid'?'primary':''}}" data-id="{{item.id}}" bindtap="pay">{{item.status==='unpaid'?'模拟缴费':'查看状态'}}</button></view></view><view class="empty" wx:if="{{!visibleBills.length}}">暂无对应账单</view><view class="notice">演示不收款、不调用支付接口；退租结算中的账单不会显示为已付款。</view></view>
