<view class="page"><view class="vi-brand-row"><image class="vi-corporate-logo" src="/assets/brand/betech-logo-orange.png" mode="aspectFit"/><text>Beline Home</text></view><view class="eyebrow">Beline Home · SMART LIVING</view><view class="row"><view><view class="h1">{{isStaff?'管家工作台':'住得安心，每一天'}}</view><view class="muted">{{tenant.name}} · {{isStaff?'让日常运营更从容':'欢迎回家，'+room.resident}}</view></view><view class="mark brand-symbol"><image src="/assets/brand/betech-symbol-orange.png" mode="aspectFit"/></view></view>
<block wx:if="{{!isStaff}}"><view class="hero"><view class="row"><text>{{room.project}}</text><text class="pill">{{room.statusText}}</text></view><view class="roomno">{{room.number}} <text style="font-size:26rpx">室</text></view><view class="muted">{{room.type}} · {{room.area}} m² · 租约至 {{room.end}}</view><button class="primary wide" bindtap="unlock">模拟开门</button><view class="muted" style="text-align:center;margin-top:16rpx">{{room.online?'门锁在线 · '+room.grant:'门锁离线 · 指令将待同步'}}</view></view><view class="quick"><button bindtap="bills"><view class="symbol"><image src="/assets/icons/wallet.png" mode="aspectFit"/></view>缴纳费用</button><button bindtap="meters"><view class="symbol"><image src="/assets/icons/water.png" mode="aspectFit"/></view>水电用量</button><button bindtap="repair"><view class="symbol"><image src="/assets/icons/tool.png" mode="aspectFit"/></view>报修服务</button><button bindtap="contract"><view class="symbol"><image src="/assets/icons/bill.png" mode="aspectFit"/></view>我的租约</button></view><view class="section">我的生活账单</view><view class="card row"><view><view class="sub">待缴费用</view><view class="amount">{{unpaidText}}</view><view class="sub">房租及本期水电账单</view></view><button class="smallbtn primary" bindtap="bills">查看账单</button></view><view class="grid"><view class="metric"><view class="muted">电表累计 · kWh</view><view class="number">{{room.electricText}}</view></view><view class="metric"><view class="muted">水表累计 · m³</view><view class="number">{{room.waterText}}</view></view></view></block>
<block wx:else><view class="grid" style="margin-top:30rpx"><view class="metric"><view class="muted">在管房间</view><view class="number">{{rooms.length}}</view></view><view class="metric"><view class="muted">已入住 / 待出租</view><view class="number">{{occupied}} / {{vacant}}</view></view><view class="metric"><view class="muted">离线房间</view><view class="number">{{offline}}</view></view><view class="metric"><view class="muted">待受理报修</view><view class="number">{{pending}}</view></view></view><view class="row section"><text>房间管理</text><button class="smallbtn" bindtap="sync">同步抄表</button></view><view class="roomgrid"><view class="roomcard {{item.status}}" wx:for="{{rooms}}" wx:key="id" data-id="{{item.id}}" bindtap="roomAction"><view class="row"><view class="roomno">{{item.number}}</view><text class="pill">{{item.statusText}}</text></view><view class="sub">{{item.project}}</view><view class="strong" style="margin-top:12rpx">{{item.resident||'等待下一位住户'}}</view><view class="sub">{{item.online?'设备在线':'离线 / 未绑定'}} · {{item.rentText}}/月</view></view></view></block><view class="notice">交互演示 · 不调用 TTLock，不操作真实门锁，不产生扣费。可在“我的”切换住户与管家身份。</view><view class="footer">必达公寓云 · 让租住管理更从容</view></view>
