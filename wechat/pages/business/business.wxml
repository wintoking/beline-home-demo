<view class="page"><view class="vi-brand-row"><image class="vi-corporate-logo" src="/assets/brand/betech-logo-orange.png" mode="aspectFit"/><text>Beline Home</text></view><view class="eyebrow">OPERATIONS CENTER</view><view class="h1">{{isAgent?'合作工作台':'业务中心'}}</view><view class="muted">{{tenant.name}} · {{isManager?'房东 / 管家':isAgent?'服务商授权范围':'住户工作区'}}</view><view class="notice">演示身份、合同、充值与设备操作，不触发真实签约、支付或 TTLock 请求。</view><view class="field"><text>选择业务</text><picker range="{{sections}}" value="{{sectionIndex}}" bindchange="section"><view class="select">{{sections[sectionIndex]}}</view></picker></view>
<block wx:if="{{!formOpen}}"><view class="grid" wx:if="{{section==='finance'}}"><view class="metric"><view class="muted">本次实收流水</view><view class="number">{{financeSummary.received}}</view></view><view class="metric"><view class="muted">待收费用</view><view class="number">{{financeSummary.unpaid}}</view></view><view class="metric"><view class="muted">押金记录</view><view class="number">{{financeSummary.deposit}}</view></view><view class="metric"><view class="muted">运营支出</view><view class="number">{{financeSummary.expense}}</view></view></view><view class="row" style="margin:20rpx 0"><button wx:if="{{canCreate}}" class="smallbtn primary" bindtap="create">{{section==='rentals'?'预约看房':section==='contracts'?'起草合同':section==='credentials'?'新增凭证':'申请服务'}}</button><button wx:if="{{isManager && section==='rentals'}}" class="smallbtn" bindtap="addRoom">房源建档</button><button wx:if="{{isManager && section==='finance'}}" class="smallbtn" bindtap="expense">登记支出</button><button wx:if="{{isManager && section==='meters'}}" class="smallbtn" bindtap="sync">模拟抄表</button></view><view class="card" wx:for="{{items}}" wx:key="id" data-id="{{item.id}}" bindtap="item"><view class="row"><view class="strong">{{item.title}}</view><text class="pill">{{item.status}}</text></view><view class="muted" style="margin-top:12rpx">{{item.detail}}</view><view class="sub">点击查看或处理 ›</view></view><view class="notice" wx:if="{{!items.length}}">当前范围暂无记录。可在本页创建演示业务，或在 Web 管理台完善本商户台账。</view></block>
<block wx:else><view class="notice" wx:if="{{error}}">{{error}}</view><view class="field" wx:for="{{fields}}" wx:key="key"><text>{{item.label}}</text><textarea wx:if="{{item.type==='textarea'}}" value="{{form[item.key]}}" data-field="{{item.key}}" bindinput="input"/><picker wx:elif="{{item.type==='room'}}" range="{{rooms}}" range-key="label" value="{{item.index}}" data-index="{{index}}" bindchange="select"><view class="select">{{rooms[item.index].label}}</view></picker><picker wx:elif="{{item.type==='property'}}" range="{{properties}}" range-key="name" value="{{item.index}}" data-index="{{index}}" bindchange="select"><view class="select">{{properties[item.index].name}}</view></picker><picker wx:elif="{{item.type==='select'}}" range="{{item.options}}" value="{{item.index}}" data-index="{{index}}" bindchange="select"><view class="select">{{form[item.key]}}</view></picker><picker wx:elif="{{item.type==='date'}}" mode="date" value="{{form[item.key]}}" data-field="{{item.key}}" bindchange="input"><view class="select">{{form[item.key]}}</view></picker><checkbox-group wx:elif="{{item.type==='checkbox'}}" data-field="{{item.key}}" bindchange="check"><label><checkbox value="yes" checked="{{form[item.key]}}" color="#ff5100"/>确认</label></checkbox-group><input wx:else type="{{item.type==='number'?'digit':'text'}}" value="{{form[item.key]}}" data-field="{{item.key}}" bindinput="input"/></view><block wx:if="{{formKind==='service'||formKind==='resolve'||formKind==='room'}}"><button bindtap="photos">选择本地演示照片</button><image wx:for="{{photos}}" wx:key="path" wx:for-item="photo" src="{{photo.path}}" mode="aspectFill" style="width:160rpx;height:160rpx;margin:10rpx"/></block><button class="primary wide" bindtap="submit">确认保存演示操作</button><button class="wide" bindtap="cancel">取消</button></block><view class="footer">必达公寓云 · 本地演示台账</view></view>
